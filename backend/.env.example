# Copy this file to .env (in the backend folder) and fill in your own values.
# Never commit .env.

# Google Gemini API key. Get one free at https://aistudio.google.com/apikey
# Paste your key after the = sign. Leave blank to run in deterministic fallback mode.
GOOGLE_API_KEY=

# Set to true to force fallback mode even when a key is present.
DEMO_MODE=false

# Optional. Gemini model used for AI features.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Seconds to wait for an AI response before falling back.
# AI_TIMEOUT_SECONDS=60

# Local semantic matching (Sentence Transformers). The model (~90 MB) downloads
# once on first use. Set to false to turn it off.
SEMANTIC_MATCHING=true

# Optional. Minimum similarity (0 to 1) for a semantic match. Higher = stricter.
# SEMANTIC_THRESHOLD=0.6

# Optional. Defaults to a SQLite file at backend\app.db
# DATABASE_URL=sqlite:///./app.db

# Optional. Comma-separated origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
